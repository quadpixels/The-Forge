//note: normalized random, float=[0, 1]
float PDnrand( float2 n ) {
	return frac( sin(dot(n.xy, float2(12.9898, 78.233f)))* 43758.5453 );
}
float2 PDnrand2( float2 n ) {
	return frac( sin(dot(n.xy, float2(12.9898, 78.233f)))* float2(43758.5453, 28001.8384) );
}
float3 PDnrand3( float2 n ) {
	return frac( sin(dot(n.xy, float2(12.9898, 78.233f)))* float3(43758.5453, 28001.8384, 50849.4141 ) );
}
float4 PDnrand4( float2 n ) {
	return frac( sin(dot(n.xy, float2(12.9898, 78.233f)))* float4(43758.5453, 28001.8384, 50849.4141, 12996.89) );
}

// Convert uniform distribution into triangle-shaped distribution.
// https://www.shadertoy.com/view/4t2SDh
// Input is in range [0, 1]
// Output is in range [-1, 1], which is useful for dithering.
float2 uniformNoiseToTriangular(float2 n) {
	float2 orig = n*2.0-1.0;
	n = orig*rsqrt(abs(orig));
	n = max(f2(-1.0), n);
	n = n-float2(sign(orig));
	return n;
}

#define WF_PATH_STRIDE 5
#define WF_MAX_BOUNCES 2

struct SurfaceHit
{
    uint hit;
    float3 position;
    float3 normal;
    float4 matColor;
};

SurfaceHit TraceClosestSurface(RayDesc ray)
{
    SurfaceHit outHit;
    outHit.hit = 0;
    outHit.position = f3(0.0f);
    outHit.normal = f3(0.0f);
    outHit.matColor = f4(0.0f);

    const RayTraversalFlags traversalFlags =
        RAY_TRAVERSAL_FLAG_USE_SHARED_STACK |
        RAY_TRAVERSAL_FLAG_NO_AABB_GEOMETRY |
        RAY_TRAVERSAL_FLAG_NO_AABB_INSTANCE;

    float3 uvw;
    float2 uv;
    uint geometryIndex = 0;
    uint triangleIndex = 0;
    uint indexOffset = 0;
    float2 barycentricCoords = f2(0.0f);
    uint i0 = 0, i1 = 0, i2 = 0;
    float4 matColor = f4(0.0f);

    RayQueryClosestHit(gRtScene, traversalFlags, RAY_FLAG_SKIP_AABB, ray, 0xFF, hit);

    LOOP
    RayQueryBeginForEachCandidate(hit)
    {
        if (RayQueryIsHitNonOpaqueTriangle(hit))
        {
            geometryIndex = RayQueryCandidateGeometryIndex(hit);
            triangleIndex = RayQueryCandidatePrimitiveIndex(hit);
            barycentricCoords = RayQueryCandidateBarycentrics(hit);
            indexOffset = LoadByte(gIndexOffsets, geometryIndex << 2);

            uvw.yz = barycentricCoords;
            uvw.x = 1.0f - uvw.y - uvw.z;

            uint4 i012 = LoadByte4(gIndexDataBuffer, ((3 * triangleIndex + indexOffset) << 2));
            i0 = i012[0]; i1 = i012[1]; i2 = i012[2];

            float2 uv012[3] = {
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i0 << 2)),
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i1 << 2)),
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i2 << 2))
            };
            uv = uvw.x * uv012[0] + uvw.y * uv012[1] + uvw.z * uv012[2];

            BeginNonUniformResourceIndex(geometryIndex, TOTAL_IMGS);
            matColor = SampleLvlTex2D(gMaterialTextures[geometryIndex], gSamplerTrilinearWrap, uv, 0).rgba;
            EndNonUniformResourceIndex();

            if (matColor.a > 0.5f)
                RayQueryCommitCandidate(hit);
        }
        RayQueryProceed(hit);
    }
    RayQueryEndForEachCandidate(hit);

    if (!RayQueryIsHit(hit))
        return outHit;

    uint hitGeometryIndex = RayQueryGeometryIndex(hit);
    uint hitTriangleIndex = RayQueryPrimitiveIndex(hit);
    float2 hitBarycentricCoords = RayQueryBarycentrics(hit);

    if (hitGeometryIndex != geometryIndex ||
        hitTriangleIndex != triangleIndex ||
        hitBarycentricCoords.x != barycentricCoords.x ||
        hitBarycentricCoords.y != barycentricCoords.y)
    {
        triangleIndex = hitTriangleIndex;
        barycentricCoords = hitBarycentricCoords;
        geometryIndex = hitGeometryIndex;
        indexOffset = LoadByte(gIndexOffsets, geometryIndex << 2);

        uvw.yz = barycentricCoords;
        uvw.x = 1.0f - uvw.y - uvw.z;

        uint4 i012 = LoadByte4(gIndexDataBuffer, ((3 * triangleIndex + indexOffset) << 2));
        i0 = i012[0]; i1 = i012[1]; i2 = i012[2];

        float2 uv012[3] = {
            unpack2Floats(LoadByte(gVertexTexCoordBuffer, i0 << 2)),
            unpack2Floats(LoadByte(gVertexTexCoordBuffer, i1 << 2)),
            unpack2Floats(LoadByte(gVertexTexCoordBuffer, i2 << 2))
        };
        uv = uvw.x * uv012[0] + uvw.y * uv012[1] + uvw.z * uv012[2];

        BeginNonUniformResourceIndex(geometryIndex, TOTAL_IMGS);
        matColor = SampleLvlTex2D(gMaterialTextures[geometryIndex], gSamplerTrilinearWrap, uv, 0).rgba;
        EndNonUniformResourceIndex();
    }

    float4 position012[3] =
    {
        asfloat(LoadByte4(gVertexPositionBuffer, ((i0 * 3) << 2))),
        asfloat(LoadByte4(gVertexPositionBuffer, ((i1 * 3) << 2))),
        asfloat(LoadByte4(gVertexPositionBuffer, ((i2 * 3) << 2)))
    };
    float3 normal012[3] =
    {
        decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, i0 << 2))),
        decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, i1 << 2))),
        decodeDir(unpackUnorm2x16(LoadByte(gVertexNormalBuffer, i2 << 2)))
    };

    float3 position = uvw.x * position012[0].xyz + uvw.y * position012[1].xyz + uvw.z * position012[2].xyz;
    position = mul(gSettings.mWorldMatrix, float4(position, 1.0f)).xyz;
    float3 normal = normalize(uvw.x * normal012[0].xyz + uvw.y * normal012[1].xyz + uvw.z * normal012[2].xyz);

    outHit.hit = 1;
    outHit.position = position;
    outHit.normal = normal;
    outHit.matColor = matColor;
    return outHit;
}

bool TraceShadowRay(float3 rayOrigin, float3 lightDir)
{
    const RayTraversalFlags traversalFlags =
        RAY_TRAVERSAL_FLAG_USE_SHARED_STACK |
        RAY_TRAVERSAL_FLAG_NO_AABB_GEOMETRY |
        RAY_TRAVERSAL_FLAG_NO_AABB_INSTANCE;

    RayDesc shadowRay;
    shadowRay.Origin = rayOrigin;
    shadowRay.Direction = lightDir;
    shadowRay.TMin = 0.001f;
    shadowRay.TMax = 10000.0f;

    RayQueryAnyHit(gRtScene, traversalFlags,
        RAY_FLAG_SKIP_AABB | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH,
        shadowRay, 0xFF, shadowHit);

    LOOP
    RayQueryBeginForEachCandidate(shadowHit)
    {
        if (RayQueryIsHitNonOpaqueTriangle(shadowHit))
        {
            uint triangleIndex = RayQueryCandidatePrimitiveIndex(shadowHit);
            float2 barycentricCoords = RayQueryCandidateBarycentrics(shadowHit);
            uint geometryIndex = RayQueryCandidateGeometryIndex(shadowHit);
            uint indexOffset = LoadByte(gIndexOffsets, geometryIndex << 2);

            float3 uvw;
            uvw.yz = barycentricCoords;
            uvw.x = 1.0f - uvw.y - uvw.z;

            uint4 i012 = LoadByte4(gIndexDataBuffer, ((3 * triangleIndex + indexOffset) << 2));
            uint i0 = i012[0], i1 = i012[1], i2 = i012[2];

            float2 uv012[3] = {
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i0 << 2)),
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i1 << 2)),
                unpack2Floats(LoadByte(gVertexTexCoordBuffer, i2 << 2))
            };
            float2 uv = uvw.x * uv012[0] + uvw.y * uv012[1] + uvw.z * uv012[2];

            float alpha;
            BeginNonUniformResourceIndex(geometryIndex, TOTAL_IMGS);
            alpha = SampleLvlTex2D(gMaterialTextures[geometryIndex], gSamplerTrilinearWrap, uv, 0).a;
            EndNonUniformResourceIndex();

            if (alpha > 0.5f)
                RayQueryCommitCandidate(shadowHit);
        }
        RayQueryProceed(shadowHit);
    }
    RayQueryEndForEachCandidate(shadowHit);

    return RayQueryIsHit(shadowHit);
}

RayDesc GenerateCameraRay(uint2 pixel)
{
    uint2 launchDim = uint2(gSettings.mWidth, gSettings.mHeight);
    float2 crd = float2(pixel) + gSettings.mSubpixelJitter;
    float2 dims = float2(launchDim);
    float2 d = ((crd / dims) * 2.0f - 1.0f);
    d.y *= -1.0f;

    float3 direction = normalize(float3(d * gSettings.mZ1PlaneSize, 1.0f));
    float3 directionWS = mul(
        float3x3(gSettings.mCameraToWorld[0].xyz,
                 gSettings.mCameraToWorld[1].xyz,
                 gSettings.mCameraToWorld[2].xyz),
        direction);

    RayDesc ray;
    ray.TMin = 0.001f;
    ray.TMax = 10000.0f;
    ray.Direction = directionWS;
    ray.Origin = getCol(gSettings.mCameraToWorld, 3).xyz + directionWS * gSettings.mProjNear;
    return ray;
}

float3 GenerateBounceDirection(uint pixelIndex, uint bounce, float3 normal)
{
    uint2 pixel = uint2(pixelIndex % gSettings.mWidth, pixelIndex / gSettings.mWidth);
    float2 pixelUV = (float2(pixel) + f2(0.5f)) / float2(gSettings.mWidth, gSettings.mHeight);
    float2 sampleVal =
        uniformNoiseToTriangular(PDnrand2(pixelUV + gSettings.mRandomSeed + bounce)) * 0.5f + 0.5f;
    return alignHemisphereWithNormal(sampleCosineWeightedHemisphere(sampleVal), normal);
}

void StorePath(uint pathId, RayDesc ray, float3 throughput, uint bounce,
               float3 radiance, uint pixelIndex, float3 primaryAlbedo, float active)
{
    uint b = pathId * WF_PATH_STRIDE;
    gWavefrontPathState[b + 0] = float4(ray.Origin, ray.TMin);
    gWavefrontPathState[b + 1] = float4(ray.Direction, ray.TMax);
    gWavefrontPathState[b + 2] = float4(throughput, asfloat(bounce));
    gWavefrontPathState[b + 3] = float4(radiance, asfloat(pixelIndex));
    gWavefrontPathState[b + 4] = float4(primaryAlbedo, active);
}

void LoadPath(uint pathId, out RayDesc ray, out float3 throughput, out uint bounce,
              out float3 radiance, out uint pixelIndex, out float3 primaryAlbedo, out float active)
{
    uint b = pathId * WF_PATH_STRIDE;
    float4 a = gWavefrontPathState[b + 0];
    float4 d = gWavefrontPathState[b + 1];
    float4 t = gWavefrontPathState[b + 2];
    float4 r = gWavefrontPathState[b + 3];
    float4 p = gWavefrontPathState[b + 4];
    ray.Origin = a.xyz; ray.TMin = a.w;
    ray.Direction = d.xyz; ray.TMax = d.w;
    throughput = t.xyz; bounce = asuint(t.w);
    radiance = r.xyz; pixelIndex = asuint(r.w);
    primaryAlbedo = p.xyz; active = p.w;
}

void AccumulateOutput(uint2 pixel, float3 payloadRadiance, float3 primaryAlbedo)
{
    float4 accumulatedRadiance = f4(0.0f);
    if (gSettings.mFrameIndex == 0)
        accumulatedRadiance = float4(payloadRadiance, 1.0f);
    else
    {
#if UAV_RW_FALLBACK
        accumulatedRadiance = Load2D(gInput, pixel);
#else
        accumulatedRadiance = LoadRWTex2D(gOutput, pixel);
#endif
        accumulatedRadiance.w += 1.0f;
        accumulatedRadiance.rgb += (payloadRadiance - accumulatedRadiance.rgb) / accumulatedRadiance.w;
    }
    Write2D(gOutput, pixel, accumulatedRadiance);

#if DENOISER_ENABLED
    float3 accumulatedAlbedo = f3(0.0f);
    if (gSettings.mFramesSinceCameraMove == 0)
        accumulatedAlbedo = primaryAlbedo;
    else
    {
        float invWeight = float(gSettings.mFramesSinceCameraMove + 1);
#if UAV_RW_FALLBACK
        accumulatedAlbedo = Load2D(gAlbedoInput, pixel).rgb;
#else
        accumulatedAlbedo = LoadRWTex2D(gAlbedoOutput, pixel).rgb;
#endif
        accumulatedAlbedo += (primaryAlbedo - accumulatedAlbedo) / invWeight;
    }
    Write2D(gAlbedoOutput, pixel, float4(accumulatedAlbedo, 1.0f));
#endif
}
